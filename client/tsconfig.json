{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "jsx": "preserve", "skipLibCheck": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@shared/*": ["../shared/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../shared/**/*.ts", "env.d.ts"]
}
